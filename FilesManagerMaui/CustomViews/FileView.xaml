<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilesManagerMaui.CustomViews.FileView"
             xmlns:io="clr-namespace:System.IO;assembly=System.RunTime"
             
             x:DataType="io:FileInfo">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Source="file_icon.png"
               WidthRequest="35"
               HeightRequest="35"
               VerticalOptions="Start"/>

        <Label Text="{Binding Name}"
               FontFamily="GeistPixelRegular"
               Grid.Column="1" VerticalOptions="Center" LineBreakMode="NoWrap"/>
    </Grid>
</ContentView>
