<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilesManagerMaui.CustomViews.FileView"
             xmlns:io="clr-namespace:System.IO;assembly=System.RunTime"
             
             x:DataType="io:FileInfo">
    <Grid ColumnDefinitions="1*, 1*, 1*, 1*">
        <Label Text="{Binding Name}"/>
        <Label Text="{Binding CreationTime}" HorizontalOptions="Center" Grid.Column="1"/>
        <Label Text="{Binding Length}" HorizontalOptions="Center" Grid.Column="2"/>
        <Label Text="{Binding Extension}" HorizontalOptions="Center" Grid.Column="3"/>
    </Grid>
</ContentView>
