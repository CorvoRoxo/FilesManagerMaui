<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilesManagerMaui.MainPage"
             xmlns:io="clr-namespace:System.IO;assembly=System.Runtime"
             xmlns:local="clr-namespace:FilesManagerMaui"
             xmlns:customViews="clr-namespace:FilesManagerMaui.CustomViews"
             >

    <VerticalStackLayout Padding="5">
        <Entry x:Name="CurrentDirectoryEntry" Text="C:\Users\win10\Desktop" TextChanged="CurrentDirectoryEntry_TextChanged"/>

        <ScrollView MaximumHeightRequest="600">
            <VerticalStackLayout>
                <Button Text=".." Clicked="PreviousDirectory_ButtonClicked"/>

                <CollectionView ItemsSource="{Binding Source={x:Static local:FilesManager.DirectoriesInFolder}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="io:DirectoryInfo">
                            <customViews:DirectoryView />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <CollectionView ItemsSource="{Binding Source={x:Static local:FilesManager.FilesInFolder}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="io:FileInfo">
                            <customViews:FileView />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>
